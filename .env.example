# Set the OpenRouter key locally. Never commit .env.
OPENROUTER_API_KEY=
OPENAI_API_KEY=${OPENROUTER_API_KEY}
OPENAI_BASE_URL=https://openrouter.ai/api/v1
AUTOKAGGLE_MODEL=openai/gpt-6.1-sol
AUTOKAGGLE_MODE=model
# Local development binds to localhost and does not require email sign-in.
AUTOKAGGLE_PRIVATE_MODE=0
